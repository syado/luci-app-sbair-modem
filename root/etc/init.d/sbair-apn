#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: MIT
# Copyright (c) 2026 soralis0912
#
# 起動時に、いま刺さっている SIM の ICCID に対応する APN を network.wan へ流す。
#
# **登録が無ければ何もしない。** 空の APN を書き込むと、ベンダの
# check_auto_apn_prov (SIM から APN を引く仕組み) を潰しかねない。
#
# netifd より後に走らせる。先に走っても ifup する相手がいない。

START=95
STOP=01

boot() {
	# モデムが SIM を読み終えるまで待つ。起動直後は +CCID が空を返す。
	( for i in $(seq 30); do
		[ -n "$(/usr/bin/sbair-modem at 'AT+CCID' 2>/dev/null)" ] && break
		sleep 2
	  done
	  /usr/bin/sbair-modem apn apply >/dev/null 2>&1
	) &
}

start() {
	/usr/bin/sbair-modem apn apply
}
